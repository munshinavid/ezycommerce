<IfModule mod_rewrite.c>
    RewriteEngine On

    # If the requested file or directory exists in /public (like css, js, images), serve it directly
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Otherwise, pass all remaining requests to index.php
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# Disable directory browsing for security
Options -Indexes

# Deny access to hidden files
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>
